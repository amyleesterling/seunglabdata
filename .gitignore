# Render intermediates. The mp4 and the labelled still ARE the deliverables;
# the per frame PNGs are how they were made. 240 frames is ~300 MB per
# sequence, and a GitHub Pages repo carries that weight forever.
# The frames stay on disk for review, they just do not go into git.
assets/mec/population/turntable/
assets/mec/population/turntable66/
assets/mec/population/turntable118/
assets/mec/population/cycle/frames/
assets/mec/population/cycle/labelled/
assets/mec/population/cycle/layer_*.png
assets/mec/population/cycle/plate.png
assets/mec/population/layers/frames/
assets/mec/population/layers/labelled/
assets/mec/population/layers/layer_*.png
assets/mec/population/layers/plate.png
assets/mec/renders/spin/
assets/mec/population/depth/frames/
assets/mec/population/depth/labelled/
assets/mec/population/depth/layer_*.png
assets/mec/population/depth/plate.png
assets/mec/population/dense/
assets/mec/population/turntable782/
assets/mec/population/banner/still.png
assets/mec/population/buildup/
assets/mec/population/fly/
assets/mec/population/p_still/
assets/mec/population/p_cycle/
assets/mec/population/p_layers/
assets/mec/population/p_depth/
assets/mec/population/p_turn/
assets/mec/population/poster_hi/

# Close tier meshes are a local RENDER input, not a web asset: 244 cells at
# 140k faces is 485 MB and nothing on the page ever fetches them. The manifest
# still lists the tier, and the renderer falls back with a loud warning when
# the files are not on disk. Rebuild with tools/mec_path_cells.json.
assets/mec/cells/*.close.glb
assets/mec/population/tour/
assets/mec/population/fly2/
assets/mec/population/slowturn/
assets/mec/population/t_fly*/

# Python bytecode. It was committed by accident and changes on every run.
__pycache__/
*.pyc

# The macro tier is one cell at 75 faces/um2, 18 MB, for the bottom of the
# scale ladder. A render input like the close tier, never served.
assets/mec/cells/*.macro.glb
assets/mec/population/islands2/
assets/mec/population/islands2_still/
assets/mec/population/explode/
assets/mec/population/ladder/
assets/mec/population/islands/
assets/mec/population/islands_still/
assets/mec/population/tour/
assets/mec/population/ladder2/
assets/mec/population/fly2/
assets/mec/population/ladder3/
